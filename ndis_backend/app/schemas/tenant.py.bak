# ============================================================================
# Authentication Schemas
# ============================================================================

class LoginRequest(BaseModel):
    """Payload to authenticate user within a specific tenant context."""
    email: EmailStr
    password: str
    tenant_code: str = Field(..., description="Unique tenant slug code (e.g. CARE-001)")


class TokenResponse(BaseModel):
    """JWT Bearer authentication token response."""
    access_token: str
    token_type: str = "bearer"
    user_id: str
    tenant_id: int
    full_name: str
    is_tenant_admin: bool
